# Backend
APP_NAME=DBSS
API_PREFIX=/api
ENV=dev
LOG_LEVEL=INFO

# Auth
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# DB: MySQL (docker compose uses host port 3307)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DB=video_conference
MYSQL_USER=lhy
MYSQL_PASSWORD=SyncPwd_111111

# DB: Postgres
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=video_conference
PG_USER=lhy
PG_PASSWORD=SyncPwd_111111

# DB: Oracle XE
ORACLE_HOST=127.0.0.1
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=XEPDB1
# NOTE: 必须与 deploy/.env 的 ORACLE_APP_USER 一致（默认是 lhy）
ORACLE_USER=lhy
ORACLE_PASSWORD=SyncPwd_111111
# Optional: if tables are created under another schema (e.g. you previously used a different APP_USER),
# set ORACLE_SCHEMA=SYNCAPP (without quotes). Default is ORACLE_USER uppercased.
# ORACLE_SCHEMA=

# Sync (poll events from one source DB)
SYNC_SOURCE_DB=mysql
SYNC_POLL_SECONDS=2
