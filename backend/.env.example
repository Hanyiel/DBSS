# Backend
APP_NAME=DBSS
API_PREFIX=/api
ENV=dev
LOG_LEVEL=INFO

# Auth
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# DB: MySQL (docker compose uses host port 3307)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DB=video_conference
MYSQL_USER=lhy
MYSQL_PASSWORD=SyncPwd_111111

# DB: Postgres
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=video_conference
PG_USER=lhy
PG_PASSWORD=SyncPwd_111111

# DB: Oracle XE
ORACLE_HOST=127.0.0.1
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=XEPDB1
# NOTE: 必须与 deploy/.env 的 ORACLE_APP_USER 一致（默认是 lhy）
ORACLE_USER=lhy
ORACLE_PASSWORD=SyncPwd_111111
# Optional: if tables are created under another schema (e.g. you previously used a different APP_USER),
# set ORACLE_SCHEMA=SYNCAPP (without quotes). Default is ORACLE_USER uppercased.
# ORACLE_SCHEMA=

# Sync (poll events from one source DB)
SYNC_SOURCE_DB=mysql
SYNC_POLL_SECONDS=2
SYNC_ENABLED=true
# realtime: poll change_log frequently; scheduled: run sync every SYNC_INTERVAL_SECONDS
SYNC_MODE=realtime
# 10 minutes (used when SYNC_MODE=scheduled)
SYNC_INTERVAL_SECONDS=600
SYNC_BATCH_LIMIT=50
SYNC_RUN_ON_STARTUP=true

# Reconcile (periodic consistency scan -> conflicts)
# Enable to scan business tables every minute and record inconsistencies into conflicts table.
RECONCILE_ENABLED=false
RECONCILE_INTERVAL_SECONDS=60
RECONCILE_WINDOW_MINUTES=5
RECONCILE_MAX_PKS=200
RECONCILE_FULL_SCAN_MAX_PKS=5000
RECONCILE_STORE_DB=mysql
RECONCILE_AUTO_RESOLVE=false
RECONCILE_RUN_ON_STARTUP=true
RECONCILE_STARTUP_FULL_SCAN=true

# Email alerts (send email when conflicts are created)
# For 163 Mail (网易 163 邮箱), use the SMTP "授权码" (NOT your login password):
# - SMTP host: smtp.163.com
# - SSL port: 465 (recommended)  / TLS port: 587
EMAIL_ENABLED=true
EMAIL_SMTP_HOST=smtp.163.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USERNAME=g7968hyt@163.com
EMAIL_SMTP_PASSWORD=GZYJqSewPNTgdzmY
EMAIL_USE_SSL=true
EMAIL_USE_TLS=false
EMAIL_FROM=g7968hyt@163.com
# Comma-separated admin recipients
EMAIL_TO=g7968hyt@163.com
# Public URL of your frontend (used to generate click-to-view conflict link)
FRONTEND_PUBLIC_URL=http://10.118.35.69:5173
EMAIL_LINK_TOKEN_EXPIRE_MINUTES=60
EMAIL_MAX_PER_RUN=10
